<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:fitsSystemWindows="true"
        app:elevation="0dp"
        app:liftOnScroll="true">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/ch_hero">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:paddingHorizontal="20dp" android:paddingVertical="8dp">
                <com.ch.music.views.RetroShapeableImageView
                    android:id="@+id/userImage" android:layout_width="48dp" android:layout_height="48dp"
                    android:padding="4dp" android:scaleType="centerCrop" app:retroCornerSize="24dp"
                    android:contentDescription="@string/ch_open_menu" android:background="?roundSelector" />
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/searchInput" android:layout_width="0dp" android:layout_height="48dp"
                    android:layout_weight="1" android:layout_marginStart="12dp"
                    android:background="@drawable/ch_search" android:foreground="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:drawablePadding="10dp"
                    app:drawableStartCompat="@drawable/ic_search" app:drawableTint="?attr/colorPrimary"
                    android:text="@string/ch_search_hint" android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/topTabLayout" android:layout_width="match_parent" android:layout_height="48dp"
                android:background="@android:color/transparent" android:paddingHorizontal="12dp"
                app:tabMode="scrollable" app:tabGravity="start" app:tabMinWidth="64dp" app:tabIndicatorFullWidth="false"
                app:tabIndicator="@drawable/bg_netease_tab_indicator" app:tabIndicatorHeight="3dp"
                app:tabIndicatorColor="?attr/colorPrimary" app:tabSelectedTextColor="?attr/colorPrimary"
                app:tabTextColor="?android:attr/textColorSecondary" app:tabTextAppearance="@style/ChSectionTitle" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/homePager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="@integer/overScrollMode"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
