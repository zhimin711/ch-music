<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent"
    android:layout_height="match_parent" android:fitsSystemWindows="true"
    android:background="?attr/chPageBackground" android:clipToPadding="false"
    android:paddingBottom="@dimen/bottom_nav_mini_player_height">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/ch_mine_title" android:textSize="24sp" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:text="@string/ch_mine_description" android:textSize="14sp" android:textColor="?android:attr/textColorSecondary" />
        <LinearLayout android:id="@+id/profile" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:padding="20dp" android:gravity="center_vertical"
            android:background="@drawable/ch_card" android:foreground="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
            <com.ch.music.views.RetroShapeableImageView android:id="@+id/avatar" android:layout_width="56dp" android:layout_height="56dp"
                android:scaleType="centerCrop" app:retroCornerSize="28dp" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:orientation="vertical">
                <TextView android:id="@+id/accountName" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/ch_sign_in" android:textSize="18sp" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary" />
                <TextView android:id="@+id/accountHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:text="@string/ch_login_hint" android:textSize="13sp" android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginTop="24dp" android:background="@drawable/ch_card">
            <com.google.android.material.button.MaterialButton android:id="@+id/favorites" style="@style/ChEntry"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ch_favorites" app:icon="@drawable/ic_favorite" />
            <com.google.android.material.button.MaterialButton android:id="@+id/playlists" style="@style/ChEntry"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ch_playlists" app:icon="@drawable/ic_queue_music" />
            <com.google.android.material.button.MaterialButton android:id="@+id/library" style="@style/ChEntry"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ch_library" app:icon="@drawable/ic_library_music" />
            <com.google.android.material.button.MaterialButton android:id="@+id/cache" style="@style/ChEntry"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ch_cache" app:icon="@drawable/ic_audio_file" />
            <com.google.android.material.button.MaterialButton android:id="@+id/account" style="@style/ChEntry"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ch_account" app:icon="@drawable/ic_account" />
            <com.google.android.material.button.MaterialButton android:id="@+id/settings" style="@style/ChEntry"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ch_settings" app:icon="@drawable/ic_settings" />
        </LinearLayout>
        <TextView android:id="@+id/refreshStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:gravity="center_vertical" android:paddingHorizontal="12dp"
            android:textSize="14sp" android:textColor="?attr/colorPrimary" android:background="?rectSelector" />
        <TextView android:id="@+id/cacheSummary" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:paddingHorizontal="12dp" android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
