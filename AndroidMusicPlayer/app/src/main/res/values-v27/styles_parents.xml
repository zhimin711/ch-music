<resources>

    <style name="Theme.RetroMusic.Base.Adaptive" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="toolbarPopupTheme">@style/ThemeOverlay.Material3.Light</item>
        <item name="roundSelector">@drawable/round_selector</item>
        <item name="rectSelector">@drawable/rect_selector</item>
        <item name="android:actionOverflowButtonStyle">@style/Widget.ActionButton.Overflow</item>
        <item name="materialAlertDialogTheme">@style/MaterialAlertDialogTheme</item>
        <item name="materialButtonStyle">@style/MaterialButtonTheme</item>
        <item name="materialCardViewStyle">@style/Widget.Material3.CardView.Elevated</item>
        <item name="elevationOverlayColor">@color/elevationOverlay</item>
        <item name="popupMenuBackground">@drawable/popup_background</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="chPageBackground">@color/ch_page</item>
        <item name="chCardBackground">@color/ch_card</item>
        <item name="chHeroStart">@color/ch_hero</item>
        <item name="colorPrimary">@color/ch_blue</item>
        <item name="colorSecondary">@color/ch_blue</item>
        <item name="colorSurface">@color/ch_page</item>
        <item name="colorOnSurface">@color/ch_text</item>
        <item name="android:textColorPrimary">@color/ch_text</item>
        <item name="android:textColorSecondary">@color/ch_secondary</item>
    </style>

    <style name="Theme.RetroMusic.Base" parent="Theme.Material3.Dark.NoActionBar">
        <item name="toolbarPopupTheme">@style/ThemeOverlay.Material3.Dark</item>
        <item name="roundSelector">@drawable/round_selector</item>
        <item name="rectSelector">@drawable/rect_selector</item>
        <item name="android:actionOverflowButtonStyle">@style/Widget.ActionButton.Overflow</item>
        <item name="materialAlertDialogTheme">@style/MaterialAlertDialogTheme</item>
        <item name="materialButtonStyle">@style/MaterialButtonTheme</item>
        <!--Manual setting colors-->
        <item name="android:windowBackground">?colorSurface</item>
        <item name="materialCardViewStyle">@style/Widget.Material3.CardView.Elevated</item>
        <item name="elevationOverlayColor">@color/elevationOverlay</item>
        <item name="popupMenuBackground">@drawable/popup_background</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="chPageBackground">@color/ch_dark_page</item>
        <item name="chCardBackground">@color/ch_dark_card</item>
        <item name="chHeroStart">@color/ch_dark_hero</item>
        <item name="colorPrimary">@color/ch_blue_dark</item>
        <item name="colorSecondary">@color/ch_blue_dark</item>
        <item name="colorSurface">@color/ch_dark_page</item>
        <item name="colorOnSurface">#F2F5FA</item>
        <item name="android:textColorPrimary">#F2F5FA</item>
        <item name="android:textColorSecondary">#A6B1C2</item>
    </style>

    <style name="Theme.RetroMusic.Base.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="roundSelector">@drawable/round_selector</item>
        <item name="rectSelector">@drawable/rect_selector</item>
        <item name="toolbarPopupTheme">@style/ThemeOverlay.Material3.Light</item>
        <item name="android:windowBackground">?colorSurface</item>
        <item name="android:actionOverflowButtonStyle">@style/Widget.ActionButton.Overflow</item>
        <item name="materialAlertDialogTheme">@style/MaterialAlertDialogTheme</item>
        <item name="materialButtonStyle">@style/MaterialButtonTheme</item>
        <item name="materialCardViewStyle">@style/Widget.Material3.CardView.Elevated</item>
        <item name="elevationOverlayColor">@color/elevationOverlayLight</item>
        <item name="popupMenuBackground">@drawable/popup_background</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="chPageBackground">#F5F7FB</item>
        <item name="chCardBackground">#FFFFFF</item>
        <item name="chHeroStart">#E8F1FF</item>
        <item name="colorPrimary">@color/ch_blue</item>
        <item name="colorSecondary">@color/ch_blue</item>
        <item name="colorSurface">#F5F7FB</item>
        <item name="colorOnSurface">#172033</item>
        <item name="android:textColorPrimary">#172033</item>
        <item name="android:textColorSecondary">#667085</item>
    </style>
</resources>
